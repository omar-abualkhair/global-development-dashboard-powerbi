model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["Stg_Country","Geography","Population","Health","Economy","Trade_Finance","Energy","Infrastructure","Military"]

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode"]

ref table Geography
ref table Population
ref table Health
ref table Economy
ref table Trade_Finance
ref table Energy
ref table Infrastructure
ref table Military
ref table 'Insights Table'
ref table 'Recommendations Table'
ref table 'Cleaning Result'

ref cultureInfo en-US

