table Economy
	lineageTag: be11dc1c-89cd-4820-aa21-7724f6dadb4d

	measure 'Average GDP' = AVERAGE(Economy[GDP])
		lineageTag: 277885d7-1f2d-4c1c-80cb-7bf722935803

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average GDP Growth' = AVERAGE(Economy[GDP Growth Rate])
		formatString: 0.0
		lineageTag: 9e8b978c-adf1-444c-a937-96c4465f0cc2

	measure 'GDP Growth Indicator' =
			
			IF(
			    ISBLANK([Average GDP Growth]), "No Data",
			    IF([Average GDP Growth] >= 6, "High Growth",
			        IF([Average GDP Growth] >= 3, "Moderate Growth",
			            IF([Average GDP Growth] >= 0, "Low Growth", "Contracting")
			        )
			    )
			)
		lineageTag: 2a2a8d90-3fcf-4032-8406-cc2a3447da13

	measure 'Country Count' = DISTINCTCOUNT(Geography[Country])
		formatString: 0
		lineageTag: ed705adf-ec15-4581-9d54-2d7153885c2e

	measure 'High Growth Countries' =
			
			CALCULATE(
			    DISTINCTCOUNT(Geography[Country]),
			    Economy[Growth Indicator Category] = "High Growth"
			)
		formatString: 0
		lineageTag: 2401c907-d323-4c37-afb0-8154e1ffc3a1

	measure 'Highest GDP Country' =
			
			VAR MaxGDP = MAX(Economy[GDP])
			RETURN
			    CONCATENATEX(
			        FILTER(
			            VALUES(Geography[Country]),
			            CALCULATE(MAX(Economy[GDP])) = MaxGDP
			        ),
			        Geography[Country],
			        ", "
			    )
		lineageTag: 392175ee-d617-4caf-8afd-edaa0389534a

	measure 'Lowest Inflation Country' =
			
			VAR MinInflation = MIN(Economy[Inflation Rate])
			RETURN
			    CONCATENATEX(
			        FILTER(
			            VALUES(Geography[Country]),
			            CALCULATE(MIN(Economy[Inflation Rate])) = MinInflation
			        ),
			        Geography[Country],
			        ", "
			    )
		lineageTag: 7f339e43-fda2-4617-b8d7-5eea0129629f

	measure 'GDP Rank' =
			
			IF(
			    ISBLANK(MAX(Economy[GDP])),
			    BLANK(),
			    RANKX(
			        FILTER(
			            ALL(Geography[Country]),
			            NOT ISBLANK(CALCULATE(MAX(Economy[GDP])))
			        ),
			        CALCULATE(MAX(Economy[GDP])),
			        ,
			        DESC,
			        Skip
			    )
			)
		formatString: 0
		lineageTag: 794c44e6-7fd5-4966-a142-94ea75b4ad35

	measure 'Inflation Rank' =
			
			IF(
			    ISBLANK(MAX(Economy[Inflation Rate])),
			    BLANK(),
			    RANKX(
			        FILTER(
			            ALL(Geography[Country]),
			            NOT ISBLANK(CALCULATE(MAX(Economy[Inflation Rate])))
			        ),
			        CALCULATE(MAX(Economy[Inflation Rate])),
			        ,
			        ASC,
			        Skip
			    )
			)
		formatString: 0
		lineageTag: 698bd5d3-300e-4f8d-b16a-094d88662f0e

	measure 'Dynamic Title' =
			
			"Economic Overview | " &
			IF(
			    ISFILTERED(Geography[Region]),
			    IF(HASONEVALUE(Geography[Region]), SELECTEDVALUE(Geography[Region]), "Selected Regions"),
			    "All Regions"
			) &
			" | " & FORMAT([Country Count], "0") & " countries"
		lineageTag: 077f46f8-209d-4d46-916a-b0f0c5a1321b

	measure 'Growth Color' =
			
			SWITCH([GDP Growth Indicator],
			    "High Growth", "#1E8449",
			    "Moderate Growth", "#82C341",
			    "Low Growth", "#F39C12",
			    "Contracting", "#C0392B",
			    "#808080")
		lineageTag: 6d2c1fd2-89b4-42fa-8944-74d5d79b1bd3

	measure Measure
		lineageTag: f1da2e1c-d283-46e3-9ec3-9b961d04be42

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'Economic Title' =
			
			"Economic Performance | " &
			IF(ISFILTERED(Geography[Region]),
			   IF(HASONEVALUE(Geography[Region]), SELECTEDVALUE(Geography[Region]), "Selected Regions"),
			   "All Regions")
		lineageTag: 72001775-6286-494f-876a-827af97cdbd3

	measure 'Average Inflation' = AVERAGE(Economy[Inflation Rate])
		lineageTag: 90452078-2443-4e22-8350-b86a9e2df5af

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Median GDP' = MEDIAN(Economy[GDP])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 57b805ef-5201-46d9-bff6-031c119a0015

	measure 'Median Inflation' = MEDIAN(Economy[Inflation Rate])
		formatString: 0.00
		lineageTag: 395b1bb1-9860-48a2-93b2-6a0e0b972120

	measure 'Median GDP Growth' = MEDIAN(Economy[GDP Growth Rate])
		formatString: 0.00
		lineageTag: c6530b86-d636-4c2b-8b17-288386285afb

