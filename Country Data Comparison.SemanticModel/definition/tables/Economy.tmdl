	partition Economy = m
		mode: import
		source =
				let
				    Source = Stg_Country,
				    Result = Table.SelectColumns(Source, {"Country", "GDP", "GDP Per Capita", "GDP Growth Rate", "Inflation Rate", "Unemployment Rate", "Industrial Growth Rate", "Investment Pct GDP", "Public Debt Pct GDP", "External Debt", "GDP Category", "GDP Category Order", "Development Level", "Development Level Order", "Growth Indicator Category", "Growth Indicator Category Order"}),
				    #"Renamed Columns" = Table.RenameColumns(Result,{{"Development Level", "Dev. Level"}})
				in
				    #"Renamed Columns"

	annotation PBI_ResultType = Table

