table Military
	lineageTag: e9676510-0ef1-4ebc-a463-2d5a20016de8

	measure 'Average Infant Mortality' = AVERAGE(Health[Infant Mortality Rate])
		lineageTag: b499b7d9-a9a2-45b6-aa9c-87b01558e0e0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Country
		dataType: string
		isHidden
		lineageTag: 81572720-0b0e-4d9a-b508-4bdc75dbb65e
		summarizeBy: none
		sourceColumn: Country

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column 'Military Spending'
		dataType: int64
		formatString: 0
		lineageTag: 5c982311-6902-4229-938f-065080123659
		summarizeBy: sum
		sourceColumn: Military Spending

		annotation SummarizationSetBy = Automatic

	column 'Military Spending Pct GDP'
		dataType: double
		lineageTag: 650b6fb1-bf84-49c1-ae56-5cb447ed5bb1
		summarizeBy: average
		sourceColumn: Military Spending Pct GDP

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition Military = m
		mode: import
		source =
				let
				    Source = Stg_Country,
				    Result = Table.SelectColumns(Source, {"Country", "Military Spending", "Military Spending Pct GDP"})
				in
				    Result

	annotation PBI_ResultType = Table

